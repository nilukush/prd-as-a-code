{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nilukush/prd-as-a-code/main/schema/meta.schema.json",
  "title": "PRD meta.yaml",
  "description": "Identity and lifecycle metadata for one PRD directory. The CLI maps violations of these rules to its stable error messages.",
  "type": "object",
  "required": ["id", "title", "owner", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["draft", "review", "approved", "shipped", "archived"]
    },
    "stakeholders": true,
    "target_release": true,
    "depends_on": true,
    "reviewers": true,
    "approved_by": true
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "properties": {
          "reviewers": { "type": "array", "minItems": 1 }
        },
        "required": ["reviewers"]
      }
    },
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "properties": {
          "approved_by": { "type": "array", "minItems": 1 }
        },
        "required": ["approved_by"]
      }
    }
  ]
}
